# ---------------------------------------------------------------------------
# Production environment. Copy to .env and fill in — never commit the result.
#
# Nothing here is baked into an image: .dockerignore excludes every .env file
# so that `next build --output standalone` cannot copy one into the runtime
# layer. Supply these through your orchestrator's secret store.
# ---------------------------------------------------------------------------

# --- Hostnames -------------------------------------------------------------
# Dashboard host, e.g. app.requro.com
APP_HOSTNAME=
# Apex domain for tenant subdomains, e.g. requro.com (serves *.requro.com)
CLIENT_DOMAIN=

# Public URLs. NEXT_PUBLIC_* are inlined at BUILD time — they must be correct
# when the image is built, not only when it runs.
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_CLIENT_URL=https://example.com

# --- Database --------------------------------------------------------------
# Include connection_limit so replicas don't exhaust Postgres max_connections.
DATABASE_URL=postgresql://user:password@host:5432/recruit?schema=public&connection_limit=10&pool_timeout=20

# --- Auth ------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=https://app.example.com
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Object storage (Cloudflare R2, S3-compatible) --------------------------
# Leave S3_ENDPOINT unset to use real AWS S3 instead.
# R2 endpoint: https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
AWS_REGION=auto
# R2 API token (Object Read & Write), or AWS keys if S3_ENDPOINT is unset
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Private bucket for résumés and uploads
AWS_S3_BUCKET_NAME=
# Inbound mail bucket. Written by an SES receipt rule, so this one stays on AWS
# even when the rest of storage is on R2. Leave blank if inbound is unused.
AWS_EMAIL_S3_BUCKET_NAME=
INBOUND_S3_ENDPOINT=
S3_PUBLIC_URL=https://your-bucket.s3.ap-south-1.amazonaws.com/public-folder
# Hostname allowed in next/image remotePatterns for the client app
S3_IMAGE_HOSTNAME=your-bucket.s3.ap-south-1.amazonaws.com

# --- Email (Resend) --------------------------------------------------------
# Outbound mail goes through Resend. MAIL_FROM_ADDRESS must be on a domain
# verified at https://resend.com/domains (DKIM + SPF records).
# Free tier: 3,000 emails/month, 100/day.
MAIL_FROM_ADDRESS=auth@example.com
RESEND_API_KEY=

# SES SMTP credentials, still used by the INBOUND pipeline only (the receipt
# rule that writes replies to S3). Leave blank if inbound is not configured.
SMTP_IAM_USER=
SMTP_USERNAME=
SMTP_PASSWORD=
# Bearer token the SES->S3->webhook pipeline presents to /api/emails/webhook
WEBHOOK_SECRET=

# --- Paddle ----------------------------------------------------------------
# Use 'production' for live billing. 'sandbox' price IDs will not work in
# production and vice versa — update constants/price-tier.tsx to match.
NEXT_PUBLIC_PADDLE_ENV=production
NEXT_PUBLIC_PADDLE_CLIENT_KEY=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# --- reCAPTCHA (public job application form) -------------------------------
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
