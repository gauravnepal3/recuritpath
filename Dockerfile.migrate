# syntax=docker/dockerfile:1
#
# One-shot migration runner. Applies pending Prisma migrations and exits; the
# app containers wait for it to complete successfully before starting.

FROM node:22.14-alpine AS base
RUN corepack enable
WORKDIR /app

FROM base AS pruner
RUN --mount=type=cache,target=/root/.npm npm i -g turbo@2.3.3
COPY . .
RUN turbo prune @repo/database --docker

FROM base AS runner
# Same native-module toolchain as the app images: the workspace install pulls
# canvas, which builds from source.
RUN apk add --no-cache \
    libc6-compat openssl \
    python3 make g++ pkgconfig \
    cairo-dev pango-dev giflib-dev librsvg-dev pixman-dev \
    && ln -sf python3 /usr/bin/python
ENV PYTHON=/usr/bin/python3

COPY --from=pruner /app/out/json/ .
RUN --mount=type=cache,target=/pnpm-store \
    pnpm config set store-dir /pnpm-store && \
    pnpm install --frozen-lockfile

COPY --from=pruner /app/out/full/ .
RUN pnpm run generate

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 prisma \
 && chown -R prisma:nodejs /app
USER prisma

# DATABASE_URL must be supplied at run time.
CMD ["pnpm", "--filter", "@repo/database", "run", "db:migrate:deploy"]
