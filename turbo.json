{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "AUTH_SECRET",
        "AUTH_URL",
        "AUTH_GOOGLE_ID",
        "AUTH_GOOGLE_SECRET",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_CLIENT_URL",
        "NEXT_PUBLIC_PADDLE_ENV",
        "NEXT_PUBLIC_PADDLE_CLIENT_KEY",
        "NEXT_PUBLIC_RECAPTCHA_SITE_KEY",
        "S3_IMAGE_HOSTNAME"
      ]
    },
    "db:migrate:deploy": {
      "cache": false
    },
    "db:push": {},
    "db:migrate:dev": {
      "cache": false,
      "persistent": false
    },
    "db:seed": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generate": {
      "dependsOn": [
        "^generate"
      ],
      "cache": false
    },
    "lint": {
      "dependsOn": [
        "^generate"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^generate"
      ]
    }
  }
}
