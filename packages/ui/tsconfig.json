{
  "extends": "@repo/typescript-config/react-library.json",
  "compilerOptions": {
    // These components are consumed by the Next apps via `transpilePackages`,
    // i.e. always through a bundler. `nodenext` resolution rejected both the
    // extensionless subpath imports used throughout minimal-tiptap and
    // `tailwindcss/defaultTheme`, which has no exports entry.
    "moduleResolution": "bundler",
    "module": "ESNext",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@repo/ui/*": ["./src/*"]
    },
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tailwind.config.ts"],
  "exclude": ["node_modules", "dist"]
}
