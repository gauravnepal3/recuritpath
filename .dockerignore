# Dependencies — reinstalled inside the image
node_modules
**/node_modules

# Secrets — MUST NOT reach the build context. `next build` with
# output:standalone copies any .env it finds into .next/standalone,
# which the Dockerfile then copies into the runtime image.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Build output — rebuilt inside the image
.next
**/.next
**/dist
**/out
.turbo
**/.turbo

# Local / VCS noise
.git
.github
.vscode
.DS_Store
**/.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local-only Prisma engines (regenerated for linux in the image)
packages/database/generated
